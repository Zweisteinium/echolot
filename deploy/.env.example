# Copy to .env, set MUSIC, done. Everything else has a sensible default.

# Where your music lives. Echolot creates tracks/, playlists/ and inbox/ in it.
MUSIC=/srv/music

# Who owns MUSIC and ./data (see: id -u, id -g), and your time zone.
PUID=1000
PGID=1000
TZ=UTC

# The ports on this host.
ECHOLOT_PORT=8490
NAVIDROME_PORT=4533

# Your own Navidrome instead of the bundled one (then remove the navidrome service from compose.yaml).
#NAVIDROME_URL=http://192.168.1.10:4533

# Soulseek through a VPN: start with -f compose.yaml -f vpn.yaml.
# The settings for your provider are in the gluetun wiki (github.com/qdm12/gluetun-wiki).
#VPN_SERVICE_PROVIDER=protonvpn
#VPN_TYPE=wireguard
#WIREGUARD_PRIVATE_KEY=
#SERVER_COUNTRIES=Netherlands
#VPN_PORT_FORWARDING=on

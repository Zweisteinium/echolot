# Your music folder: Echolot keeps the library in tracks/, playlists in playlists/, downloads in inbox/.
MUSIC=/srv/music

# The user and group the containers run as (the owner of MUSIC and ./data), the time zone, the ports.
PUID=1000
PGID=1000
TZ=Europe/Berlin
ECHOLOT_PORT=8490
NAVIDROME_PORT=4533

# Only with vpn.yaml (see the gluetun wiki for your provider):
# VPN_SERVICE_PROVIDER=protonvpn
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# SERVER_COUNTRIES=Netherlands
# VPN_PORT_FORWARDING=on

# Copy to .env and fill in. Never commit .env.
# Music disk: tracks/ (library), playlists/, inbox/ must be on this one filesystem (files are hard-linked into place).
MUSIC_DIR=/media/music
# The Soulseek login of the pipeline goes into config/sockseek.conf (user, pass), not here.
# Spotify developer app (developer.spotify.com; your account added under "Users and Access").
# Redirect URI: http://127.0.0.1:48721/callback. See the README for getting the refresh token.
SPOTIFY_ID=
SPOTIFY_SECRET=
SPOTIFY_REFRESH=
# SoundCloud web token: the value after "OAuth " in the Authorization header of api-v2 requests.
SC_TOKEN=
